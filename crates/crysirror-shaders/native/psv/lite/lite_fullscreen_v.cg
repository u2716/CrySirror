// Oversized fullscreen triangle; GXM has no vertex index builtin.
// position (-1,-1) (3,-1) (-1,3) with uv (0,1) (2,1) (0,-1): top-left origin.
void main(float2 position : POSITION, float2 uv : TEXCOORD0,
          out float4 clip : POSITION, out float2 o_uv : TEXCOORD0, out float2 o_ndc : TEXCOORD1)
{
    clip = float4(position, 1.0, 1.0);
    o_uv = uv;
    o_ndc = position;
}
