// SPDX-License-Identifier: MPL-2.0
// exposure.wgsl fs_exposure, stage 1 of the fragment reduction: one 32x32
// F32F32 target texel per desktop metering sample (nearest texel), storing
// (weight * log2 luminance, weight). Stages 2-3 (lite_reduce_f) average 4x4
// blocks, which preserves the weighted mean; lite_exposure_f adapts.
float4 main(float2 uv : TEXCOORD0, uniform sampler2D hdr : TEXUNIT0) : COLOR
{
    // uv is the 32x32 cell centre, matching (x + 0.5) / 32.
    float3 c = tex2Dlod(hdr, float4(uv, 0.0, 0.0)).rgb;
    float lum = dot(float3(c.r == c.r ? c.r : 0.0, c.g == c.g ? c.g : 0.0, c.b == c.b ? c.b : 0.0),
                    float3(0.2126, 0.7152, 0.0722));
    float w = 1.0 - 0.5 * length(uv - float2(0.5, 0.5));
    return float4(log2(max(lum, 1e-5)) * w, w, 0.0, 1.0);
}
