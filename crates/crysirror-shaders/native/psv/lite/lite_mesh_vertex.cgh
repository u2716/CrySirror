// SPDX-License-Identifier: MPL-2.0
// pbr.wgsl vs_main / vs_skinned for the PSV tier, plus per-vertex cascade
// coordinates (the desktop shader computes them per pixel).
#include "lite_common.cgh"

uniform float4 lite_view_proj[4];
uniform float4 lite_view[4];
uniform float4 lite_model[4];
uniform float4 lite_normal[4];      // inverse-transpose model, columns
uniform float4 lite_cascade0[4];    // sun light clip of cascade 0
uniform float4 lite_cascade1[4];
#ifdef LITE_SKINNED
// 64 joints x four columns (Budget::max_joints); larger skeletons are split
// into draws by the host, never truncated.
uniform float4 lite_palette[256] : BUFFER[0];
float4 lite_joint(float j, float4 p)
{
    int b = (int)clamp(j, 0.0, 63.0) * 4;
    return lite_palette[b] * p.x + lite_palette[b + 1] * p.y + lite_palette[b + 2] * p.z + lite_palette[b + 3] * p.w;
}
float4 lite_skin(float4 p, float4 joints, float4 weights)
{
    return lite_joint(joints.x, p) * weights.x + lite_joint(joints.y, p) * weights.y
         + lite_joint(joints.z, p) * weights.z + lite_joint(joints.w, p) * weights.w;
}
#endif

void main(float3 position : POSITION,
          float3 normal : NORMAL,
          float2 uv : TEXCOORD0,
          float4 tangent : TEXCOORD1,
#ifdef LITE_SKINNED
          float4 joints : BLENDINDICES,
          float4 weights : BLENDWEIGHT,
#endif
          out float4 clip : POSITION,
          out float4 o_world : TEXCOORD0,
          out float3 o_normal : TEXCOORD1,
          out float2 o_uv : TEXCOORD2,
          out float4 o_tangent : TEXCOORD3,
          out float4 o_shadow0 : TEXCOORD4,
          out float4 o_shadow1 : TEXCOORD5)
{
    float4 p = float4(position, 1.0);
    float4 n = float4(normal, 0.0);
    float4 t = float4(tangent.xyz, 0.0);
#ifdef LITE_SKINNED
    p = lite_skin(p, joints, weights);
    n = lite_skin(n, joints, weights);
    t = lite_skin(t, joints, weights);
#endif
    float4 world = lite_xform(lite_model[0], lite_model[1], lite_model[2], lite_model[3], p);
    clip = lite_xform(lite_view_proj[0], lite_view_proj[1], lite_view_proj[2], lite_view_proj[3], world);
    float4 view = lite_xform(lite_view[0], lite_view[1], lite_view[2], lite_view[3], world);
    o_world = float4(world.xyz, -view.z);
    o_normal = lite_xform(lite_normal[0], lite_normal[1], lite_normal[2], lite_normal[3], n).xyz;
    o_tangent = float4(lite_xform(lite_model[0], lite_model[1], lite_model[2], lite_model[3], t).xyz, tangent.w);
    o_uv = uv;
    o_shadow0 = lite_xform(lite_cascade0[0], lite_cascade0[1], lite_cascade0[2], lite_cascade0[3], world);
    o_shadow1 = lite_xform(lite_cascade1[0], lite_cascade1[1], lite_cascade1[2], lite_cascade1[3], world);
}
